# Every variable is optional and public: its value is written into the built files.
# To set them locally, copy this file to .env.local (never committed).

# Umami website id. Empty: no analytics script is loaded.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Where the Umami script comes from; set only for a self-hosted Umami.
# Empty: https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# The site's full address, for absolute links in metadata and the share image.
# Empty: Next.js uses the deployment's own address (or http://localhost:3000), so the
# share image link breaks. Production: https://copylekha.vercel.app
NEXT_PUBLIC_SITE_URL=
